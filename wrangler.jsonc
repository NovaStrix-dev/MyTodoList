{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice2issue",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // The PWA is served by the same Worker as static assets.
  // Static asset requests are free and unlimited: only /api/* calls count
  // toward the 100,000 requests/day of the free plan.
  "assets": {
    "directory": "./public"
  },

  // Built-in rate limiter (no extra request, no storage).
  // Counted per client IP, per Cloudflare location.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4201",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "vars": {
    "GITHUB_API": "https://api.github.com",
    // Only needed if the PWA is served from another origin (e.g. Cloudflare Pages).
    "ALLOWED_ORIGIN": ""
  }

  // Secrets (never in this file): GITHUB_TOKEN, APP_TOKEN
  // -> npx wrangler secret put GITHUB_TOKEN
  // -> npx wrangler secret put APP_TOKEN
}
